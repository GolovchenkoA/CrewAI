# claude | local
LLM_PROVIDER=local

# Claude
ANTHROPIC_API_KEY=
#CLAUDE_MODEL=anthropic/claude-sonnet-5-5
CLAUDE_MODEL=anthropic/claude-haiku-5-5
CLAUDE_MAX_TOKENS=8192   # max output tokens per call; keep it below ~20000 (the SDK refuses larger non-streaming calls)

# Local model via Ollama (native provider)
#LOCAL_MODEL=ollama/qwen3.5:9b
LOCAL_MODEL=ollama/qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# GitHub (optional; without it the review is only printed)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Limits
MAX_DIFF_TOKENS=6000       # diff chunk size; smaller for small local context windows
MAX_RPM=30                 # model requests per minute, per agent
MAX_RETRY_LIMIT=2          # retries of an agent after an error
AGENT_TIMEOUT=900          # seconds one agent may work on a task
GUARDRAIL_RETRIES=2        # lead reviewer retries when a file:line reference is missing
LLM_TIMEOUT=600            # seconds per local-model call
REVIEW_CONCURRENCY=1       # reviews the service runs at the same time

# Switches
PLANNING=false             # true: crew planning step before the reviewers (one more LLM call)
VERBOSE=false

# Observability (optional; empty = off). If the backend is down the review still works (warning only).
# Running the app locally: http://localhost:4318. Running it with docker compose, set TRACING_ENDPOINT
# instead (http://jaeger:4318 with the "tracing" profile).
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACING_ENDPOINT=

# CrewAI built-in setting (not a project variable): true turns off CrewAI anonymous usage telemetry.
CREWAI_DISABLE_TELEMETRY=true
