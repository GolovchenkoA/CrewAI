# claude | local
LLM_PROVIDER=local

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=anthropic/claude-sonnet-5-5

# Local model via Ollama (native provider)
#LOCAL_MODEL=ollama/qwen3.5:9b
LOCAL_MODEL=ollama/qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings for Memory / Knowledge (always local)
EMBED_MODEL=mxbai-embed-large

# Flow settings
CONFIDENCE_THRESHOLD=0.7
# console = ask on the terminal, auto = approve low-confidence drafts without asking
HITL_MODE=console

# Feature switches (false = run without the MCP subprocess / Ollama embeddings)
USE_MCP=true
USE_KNOWLEDGE=true
USE_MEMORY=true
VERBOSE=false
LLM_TIMEOUT=600

CREWAI_DISABLE_TELEMETRY=true
