# claude | local
LLM_PROVIDER=local

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=anthropic/claude-sonnet-5-5

# Local model via Ollama (LiteLLM)
LOCAL_MODEL=ollama/qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings for Memory / Knowledge (always local)
EMBED_MODEL=mxbai-embed-large

# Flow settings
CONFIDENCE_THRESHOLD=0.7

CREWAI_DISABLE_TELEMETRY=true
