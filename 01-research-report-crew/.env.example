# claude | local
LLM_PROVIDER=local
MANAGER_LLM_PROVIDER=

# Claude (native Anthropic provider)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=anthropic/claude-sonnet-5-5

# Local model via Ollama (native provider)
LOCAL_MODEL=ollama/qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434

# Comma-separated pages the Researcher scrapes with ScrapeWebsiteTool (no API key needed)
SOURCE_URLS=https://docs.crewai.com/en/introduction

# sequential | hierarchical
PROCESS=sequential
TOPIC=LangGraph vs CrewAI

# CrewAI built-in setting (not a project variable): true turns off CrewAI anonymous usage telemetry.
CREWAI_DISABLE_TELEMETRY=true

# Crew behaviour
NOTES_DIR=notes
ALLOW_DELEGATION=true
VERBOSE=true
LLM_TIMEOUT=600
MIN_REPORT_WORDS=250
