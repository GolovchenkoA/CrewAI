# claude | local
LLM_PROVIDER=local
MANAGER_LLM_PROVIDER=

# Claude (via LiteLLM / native Anthropic provider)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=anthropic/claude-sonnet-5-5

# Local model via Ollama (LiteLLM)
LOCAL_MODEL=ollama/qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434

# Optional web search (otherwise DuckDuckGo is used)
SERPER_API_KEY=

# sequential | hierarchical
PROCESS=sequential
TOPIC=LangGraph vs CrewAI

CREWAI_DISABLE_TELEMETRY=true
